{
  "name": "dsh-fujiang-mobile",
  "version": "1.4.4",
  "private": true,
  "description": "富江原版人格、功能面板、知识库、报告、任务编排与插话回应，适配 DSHA。",
  "author": "HanKuCha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HanKuCha/DSH-Fujiang-Unrestricted.git"
  },
  "exports": {
    ".": "./payload/dsh-ws-helper-preset/upstream/lib/index.js",
    "./package.json": "./package.json",
    "./subagent-list-compat": "./payload/dsh-ws-helper-preset/subagent-list-compat.mjs",
    "./upstream": "./payload/dsh-ws-helper-preset/upstream/lib/index.js",
    "./communication": "./payload/dsh-ws-helper-preset/communication.mjs",
    "./schema-compat": "./payload/dsh-ws-helper-preset/schema-compat.mjs",
    "./client": "./mobile/client.js",
    "./todo-reconcile": "./payload/dsh-ws-helper-preset/todo-reconcile.mjs",
    "./tool-discovery": "./payload/dsh-ws-helper-preset/tool-discovery.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./mobile/cordis.patch.yml"
    },
    "client": {
      "entry": "client",
      "platform": "web"
    }
  },
  "files": [
    "mobile/cordis.patch.yml",
    "mobile/client.js",
    "mobile/README.md",
    "payload/dsh-ws-helper-preset",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:mobile": "node mobile/build.cjs",
    "test:mobile": "node mobile/test.cjs"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
